# Application environment: development | test | production
APP_ENV=development

# PostgreSQL (PostGIS + pgRouting)
POSTGRES_USER=ontrack
POSTGRES_PASSWORD=ontrack
POSTGRES_DB=ontrack
POSTGRES_PORT=5432

# Backend SQLAlchemy database URL (uses psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://ontrack:ontrack@localhost:5432/ontrack
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000

# Shared persistent upload directory (mounted by api and worker)
UPLOAD_STORAGE_DIR=/data/uploads

# Public client configuration (exposed via GET /api/config/public)
# In production, SUPPORT_EMAIL must be a real non-.local email address.
SUPPORT_EMAIL=support@ontrack.local
NETWORK_LAYER_MIN_ZOOM=12
MAX_UPLOAD_MB=10

# Security & logging
# Must be true in production (HTTPS).
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Nginx host port mapping
NGINX_PORT=8080
